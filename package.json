  "description": "Notification automatique de nouvelles offres LinkedIn par email",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js"
  },
  "keywords": ["linkedin", "jobs", "notifier", "nestjs"],
  "author": "Artur",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.24",
