# ─── RapidAPI (JSearch) ──────────────────────────────────────────────────────
# Clé API RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Paramètres de recherche ─────────────────────────────────────────────────
# Plusieurs filtres séparés par virgule
SEARCH_KEYWORDS=Node.js, NestJS, Nest.js
SEARCH_COUNTRY=fr
SEARCH_LANGUAGE=fr
SEARCH_LOCATION=Paris, Île-de-France

# ─── Resend (email transactionnel) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# ─── Destinataire des notifications ──────────────────────────────────────────
NOTIFY_EMAIL=your_email@example.com
